[Unit]
Description=ansbui — Ansible control-plane web UI
Documentation=https://github.com/AlteredParadox/ansbui
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ansbui
Group=ansbui
WorkingDirectory=/opt/ansbui
ExecStart=/opt/ansbui/bin/ansbui -addr 127.0.0.1:8787
Restart=on-failure
RestartSec=3
Environment=ANSBUI_CONFIG=/opt/ansbui/data/config.json
Environment=ANSBUI_RUNS=/opt/ansbui/data/runs.json
Environment=HOME=/opt/ansbui
# Uncomment after `ansbui -set-password`: refuse to start (instead of
# falling back to an UNAUTHENTICATED UI) if the credential file is
# ever missing — e.g. an incomplete restore or unmounted data dir.
#Environment=ANSBUI_AUTH_REQUIRED=1

# --- Hardening (systemd-analyze security baseline) ---
# ansbui only needs: TCP/UDP for HTTP listen + SSH + Prom fetch,
# AF_UNIX for ssh-agent socket, file IO inside /opt/ansbui.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
ProcSubset=pid

# Read-only for the install tree (root-owned), writable only
# for runtime state. A compromised process can't overwrite its
# own binary or drop a malicious helper into bin/. The two
# writable dirs:
#   data/  — config.json, runs.json, runs/
#   .ssh/  — known_hosts (TOFU appends), agent socket if any
ReadWritePaths=/opt/ansbui/data /opt/ansbui/.ssh

# Drop every capability — the service binds 8787 (unprivileged
# port) and runs entirely in user space. Empty bounding set
# means even a privilege-escalation bug in a Go dependency has
# no caps to inherit.
CapabilityBoundingSet=
AmbientCapabilities=

# Network surface: TCP for HTTP/SSH/Prom, AF_UNIX for ssh-agent.
# AF_NETLINK / AF_PACKET / AF_BLUETOOTH etc. all blocked.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Block clone-namespace tricks an attacker might use to escape
# the cgroup/private-tmp jail.
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true

# IPC isolation: ansbui only uses TCP and AF_UNIX sockets, no
# SysV/POSIX IPC objects. PrivateIPC unshares the IPC namespace
# (own message queues/shared memory/semaphores); RemoveIPC
# cleans up anything it does create at process exit.
PrivateIPC=true
RemoveIPC=true

# @system-service is the systemd-curated "normal long-running
# daemon" syscall set. It already excludes @privileged. Adding
# ~@resources would block setrlimit, which Go's runtime uses —
# don't.
SystemCallFilter=@system-service
SystemCallArchitectures=native

# Tighten the default file-creation mode so anything ansbui
# writes outside its own atomic writers (e.g. a panic log) still
# lands at 0600 / 0700.
UMask=0077

[Install]
WantedBy=multi-user.target
